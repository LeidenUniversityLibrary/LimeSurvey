[Unit]
Description=LimeSurvey proof-of-concept MySQL database

[Container]
Image=docker.io/library/mysql:8.4
Network=limesurvey.network
NetworkAlias=db
PublishPort=3307:3306
Environment=MYSQL_DATABASE=limesurvey
Environment=MYSQL_USER=limesurvey
Environment=MYSQL_PASSWORD_FILE=/run/secrets/limesurvey-db-password
Environment=MYSQL_ROOT_PASSWORD_FILE=/run/secrets/limesurvey-db-root-password
Secret=limesurvey-db-password,type=mount
Secret=limesurvey-db-root-password,type=mount
Volume=limesurvey-mysql:/var/lib/mysql

[Service]
Restart=always

[Install]
WantedBy=default.target
